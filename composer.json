{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.3.36 || ~8.4.27 || ~8.5.12",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-drift": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "git config core.hooksPath .githooks",
            "@db:up",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "@php artisan metrics:refresh",
            "npm install",
            "npm run build",
            "@doctor"
        ],
        "db:up": [
            "docker compose up -d --wait",
            "@php artisan app:wait-for-db"
        ],
        "db:reset": [
            "@db:up",
            "@php artisan migrate:fresh --seed --force",
            "@php artisan metrics:refresh"
        ],
        "data:towns": [
            "@php artisan towns:import",
            "@php artisan barangays:import"
        ],
        "data:finances": [
            "@php artisan finances:import"
        ],
        "data:finances:extract": [
            "Composer\\Config::disableProcessTimeout",
            "python tools/coa/run.py extract"
        ],
        "data:finances:test": [
            "Composer\\Config::disableProcessTimeout",
            "python tools/coa/run.py test"
        ],
        "data:finances:parse": [
            "Composer\\Config::disableProcessTimeout",
            "python tools/coa/run.py intake"
        ],
        "doctor": [
            "@php artisan app:doctor"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev:guard",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test:analytics",
            "@test:maps",
            "@test:categories",
            "@test:trend",
            "@test:geo",
            "@test:businesses",
            "@test"
        ],
        "test:maps": "node --experimental-strip-types --test tests/Frontend/finance-map.test.mjs",
        "test:trend": "node --experimental-strip-types --test tests/Frontend/trend.test.mjs",
        "test:geo": "node --experimental-strip-types --test tests/Frontend/geo.test.mjs",
        "test:businesses": "node --experimental-strip-types --test tests/Frontend/public-businesses.test.mjs",
        "test:categories": "node --experimental-strip-types --test tests/Frontend/category-table.test.mjs",
        "test:analytics": "node --experimental-strip-types --test tests/Frontend/analytics.test.mjs",
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
